end PEqualNP.Outside.L_meta_50236

theorem PEqualNP.Outside.L_meta_50236 :
∃ (D : PEqualNP.CircuitLowerBounds.Circuit) (p q r : Fin (7+D.size)),
  PEqualNP.MetaComplexity.FanInTwo D ∧ PEqualNP.MetaComplexity.NestedCover.ReadsBack 7 D ∧
  PEqualNP.NotBracket.notCount D ≤ 2 ∧ D.size ≤ 6 ∧
  ∀ t : Fin 6,
    let xs := (List.ofFn (fun i : Fin 5 => decide (i.val < t.val))) ++ [false,true]
    let w := D.wires xs
    w.getD p.val false = (6 : Nat).testBit t.val ∧
    w.getD q.val false = (40 : Nat).testBit t.val ∧
    w.getD r.val false = (52 : Nat).testBit t.val := by
  refine ⟨PEqualNP.Outside.L_meta_50236.circ, ⟨8, by decide⟩, ⟨12, by decide⟩, ⟨10, by decide⟩,
    PEqualNP.Outside.L_meta_50236.fan, PEqualNP.Outside.L_meta_50236.back, by decide, by decide, by decide⟩
